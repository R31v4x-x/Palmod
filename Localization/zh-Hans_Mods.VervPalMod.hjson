Common: {
	ReleaseMode: 放生模式
	CaptureMode: 捕捉模式
	CannotUse: 无法使用
	TeleportedCaptures: 传送捕获物
	TeleportOnCooldown: 冷却中
	CaptureFormation: 捕捉形态
	CombatFormation: 战斗形态
	CapturesReleased: 放生所有捕获物
	NothingToRelease: 没有捕获物可以放生
	Slots: 栏位
	NoCaptures: 空空如也
	SphereCommonTip:
		'''
		抓住敌怪，让它们变成你的打手
		右键点击可以在捕捉和释放模式之间切换
		捕捉球的伤害受召唤伤害加成
		其他召唤物在场时，伤害会大幅削弱
		'''
}

Items: {
	Sphere_Normal: {
		DisplayName: 捕捉球
		Tooltip: "{$Mods.VervPalMod.Common.SphereCommonTip}"
	}

